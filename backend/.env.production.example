# ==========================================
# VERCEL PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# Core Server Settings
NODE_ENV=production
PORT=4000
BODY_LIMIT=5mb
TRUST_PROXY=true

# CORS Configuration (Prevents CORS error with Firebase Hosting)
CORS_ORIGIN=https://almadox.web.app,https://almadox.firebaseapp.com

# Firebase Admin Credentials
# Option 1: Individual keys
FIREBASE_PROJECT_ID=almadox
FIREBASE_STORAGE_BUCKET=almadox.firebasestorage.app
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option 2 (Alternative): Paste entire service account json in single variable
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Azure AI Document Intelligence (ID OCR & Resume Parsing)
AZURE_DOCINT_ENDPOINT=https://collegeverse-docint.cognitiveservices.azure.com/
AZURE_DOCINT_KEY=your_azure_docint_key

# Azure OpenAI (Optional - leave blank for automatic rule-based fallback)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
