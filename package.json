{
  "name": "collegeverse",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npm --prefix backend start",
    "start:backend": "npm --prefix backend start",
    "dev:backend": "npm --prefix backend start",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test": "npm --prefix backend run test:unit",
    "test:unit": "npm --prefix backend run test:unit",
    "install:all": "npm --prefix backend install --legacy-peer-deps && npm --prefix frontend install"
  },
  "devDependencies": {
    "firebase-tools": "^13.8.0"
  }
}
