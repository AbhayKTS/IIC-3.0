{
  "name": "collegeverse",
  "version": "1.0.0",
  "private": true,
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "start:backend": "npm --prefix backend start",
    "dev:backend": "npm --prefix backend start",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "echo \"Build complete\"",
    "build:frontend": "npm --prefix frontend run build",
    "test": "npm --prefix backend run test:unit",
    "test:unit": "npm --prefix backend run test:unit",
    "install:all": "npm install && npm --prefix frontend install"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.16.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "firebase": "^12.9.0",
    "firebase-admin": "^12.2.0",
    "helmet": "^7.1.0",
    "multer": "^2.3.0",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.13.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  }
}
